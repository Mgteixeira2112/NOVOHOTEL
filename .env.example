# .env.example
# Configuração pública do cliente Supabase (use valores do ambiente de destino)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ENV=development

# Feature flags — todas desativadas por padrão durante a fundação.
# VITE_FEATURE_HOTEL_OS_COMMAND_CENTER=false
# VITE_FEATURE_HOTEL_OS_REALTIME=false
# VITE_FEATURE_HOTEL_OS_EVENTS=false
# VITE_FEATURE_PDV_V2=false
# VITE_FEATURE_TABLET_QUARTO=false
# VITE_FEATURE_OFFLINE_PWA=false
